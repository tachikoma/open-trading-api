# 프로젝트 루트용 샘플 .env 파일
# 이 파일을 프로젝트 루트(open-trading-api/.env)에 위치시키세요.
# 우선순위: 시스템 환경변수 > .env 파일 > 코드 내 기본값

# ENV_MODE: "real" 은 실전(프로덕션), "demo" 는 모의(페이퍼) 트레이딩
ENV_MODE=demo

# TRADING_ENABLED: 실제 주문을 활성화하려면 true로 설정
# 허용 값: true/false, 1/0, yes/no (대소문자 무시)
TRADING_ENABLED=true

# 텔레그램 알림 설정 (기본 비활성)
# 1: 활성, 0: 비활성
TELEGRAM_ENABLED=0
# BotFather에서 발급받은 텔레그램 봇 토큰 (예: 123456:ABCDefGhI_jklMNopQRs)
TELEGRAM_BOT_TOKEN=""
# 알림을 받을 채팅 ID (그룹 채팅 ID는 음수 예: -777777777)
TELEGRAM_CHAT_ID=""
# 텔레그램 요청 타임아웃(초)
TELEGRAM_TIMEOUT_SEC=3

# 종목명 매핑 CSV가 있는 디렉토리 (symbols_*.csv 파일을 로드)
SYMBOL_MAP_DIR="data"

# --- logging defaults for trading_bot ---
# 통합 로그 파일 경로 (실행 경로 기준 혹은 절대 경로)
LOG_FILE=logs/app.log
# 로그 회전: 최대 바이트(기본 10MiB)
LOG_MAX_BYTES=10485760
# 보관할 백업 파일 수 (기본 10)
LOG_BACKUP_COUNT=10
# 로그 레벨 (환경변수 또는 .env에서 설정 가능)
# 허용 값: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# matplotlib 로거 레벨 (폰트 DEBUG 로그 억제)
# 허용 값: DEBUG, INFO, WARNING, ERROR, CRITICAL, NOTSET
MATPLOTLIB_LOG_LEVEL=WARNING

# -----------------------------
# 리스크 관리 및 수수료 예제
# -----------------------------
# 비율 값은 퍼센트(%)로 지정합니다. 예: 3.0 = 3%, 5.0 = 5%
STOP_LOSS_PERCENT=100.0
STOP_LOSS_COOLDOWN_ENABLED=0
STOP_LOSS_COOLDOWN_DAYS=5
LOSS_SELL_BLOCK_ENABLED=true
LOSS_SELL_BLOCK_THRESHOLD_PERCENT=5.0

# 수수료/거래세 설정 예시
# COMMISSION_RATE: 편도 수수료율(소수) 예: 0.0015 = 0.15%
# TRADE_TAX_RATE: 매도 시 거래세(소수) 예: 0.002 = 0.2%
COMMISSION_RATE=0.0015
TRADE_TAX_RATE=0.002

# -----------------------------
# MA 유니버스/스크리닝 설정
# -----------------------------
# 유니버스 후보군 선택
# 허용 값: watchlist, kospi, kosdaq, kospi_kosdaq, all,
#         kospi200, kosdaq150, kospi200_kosdaq150
UNIVERSE_TARGET=watchlist

# 유니버스 CSV 일별 갱신 여부
# 허용 값: true/false, 1/0, yes/no
UNIVERSE_REFRESH_DAILY=1

# 유니버스 최대 종목 수 (0=무제한)
UNIVERSE_MAX_SYMBOLS=0

# 유니버스 캐시 디렉토리 (상대경로는 프로젝트 루트 기준)
UNIVERSE_CACHE_DIR=trading_bot/data/universe

# MA 스크리닝 사용 여부
# 허용 값: true/false, 1/0, yes/no
MA_SCREENING_ENABLED=0

# 스크리닝 기준
# 20일 평균 거래대금 최소값(원)
MA_SCREENING_MIN_AVG_VALUE=10000000000
# ADX 최소값
MA_SCREENING_ADX_THRESHOLD=25.0
# 장기 추세 MA 기간
MA_SCREENING_TREND_MA_PERIOD=60
# ATR%% 최소/최대
MA_SCREENING_ATR_PCT_MIN=1.5
MA_SCREENING_ATR_PCT_MAX=8.0
# 최종 선정 종목 수
MA_SCREENING_TOP_N=20

